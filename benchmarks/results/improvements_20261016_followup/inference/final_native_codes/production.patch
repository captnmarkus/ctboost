+py::tuple NativeFeaturePipeline::transform_categorical_codes(
+    py::list codes, py::list categories, py::object feature_names) const {
+  if (n_features_in_ < 0) {
+    throw std::invalid_argument("feature pipeline must be fitted before calling transform");
+  }
+  const std::size_t width = static_cast<std::size_t>(n_features_in_);
+  if (py::len(codes) != width || py::len(categories) != width) {
+    throw std::invalid_argument("input feature count does not match the fitted feature pipeline");
+  }
+  if (feature_names_in_.has_value() && !feature_names.is_none() &&
+      py::cast<std::vector<std::string>>(feature_names) != feature_names_in_.value()) {
+    throw std::invalid_argument("input feature names do not match the fitted feature pipeline");
+  }
+  if (width == 0U || categorical_states_.size() != width ||
+      numeric_indices_.size() != width || !one_hot_states_.empty() ||
+      !combination_states_.empty() || !text_states_.empty() || !embedding_states_.empty()) {
+    throw std::invalid_argument("categorical codes require independent categorical features");
+  }
+  std::vector<std::uint8_t> categorical_seen(width, 0U), numeric_seen(width, 0U);
+  for (const auto& state : categorical_states_) {
+    if (state.source_index < 0 || static_cast<std::size_t>(state.source_index) >= width ||
+        categorical_seen[static_cast<std::size_t>(state.source_index)]++ != 0U) {
+      throw std::invalid_argument("categorical codes require complete categorical coverage");
+    }
+  }
+  std::vector<std::size_t> output_sources;
+  output_sources.reserve(output_feature_names_.size());
+  for (int source : numeric_indices_) {
+    if (source < 0 || static_cast<std::size_t>(source) >= width ||
+        numeric_seen[static_cast<std::size_t>(source)]++ != 0U) {
+      throw std::invalid_argument("categorical codes require complete numeric coverage");
+    }
+    output_sources.push_back(static_cast<std::size_t>(source));
+  }
+  for (const auto& state : ctr_states_) {
+    if (state.source_indices.size() != 1U || state.source_indices.front() < 0 ||
+        static_cast<std::size_t>(state.source_indices.front()) >= width) {
+      throw std::invalid_argument("categorical codes require single-source CTR features");
+    }
+    output_sources.insert(output_sources.end(), state.output_names.size(),
+                          static_cast<std::size_t>(state.source_indices.front()));
+  }
+  if (output_sources.size() != output_feature_names_.size()) {
+    throw std::invalid_argument("categorical codes output layout does not match fitted state");
+  }
+
+  struct CodeColumn {
+    py::array category_array;
+    py::buffer_info category_info;
+    std::vector<std::int64_t> used_codes;
+    std::vector<std::uint8_t> row_indices;
+  };
+  std::vector<CodeColumn> columns;
+  columns.reserve(width);
+  std::size_t row_count = 0U, dictionary_rows = 0U;
+  for (std::size_t feature = 0; feature < width; ++feature) {
+    if (!py::isinstance<py::array>(codes[feature]) ||
+        !py::isinstance<py::array>(categories[feature])) {
+      throw std::invalid_argument("categorical codes and dictionaries must be NumPy arrays");
+    }
+    const py::array code_array = py::cast<py::array>(codes[feature]);
+    py::array category_array = py::cast<py::array>(categories[feature]);
+    if (code_array.ndim() != 1 || code_array.dtype().kind() != 'i' ||
+        !py::cast<bool>(code_array.dtype().attr("isnative")) ||
+        (code_array.itemsize() != 1 && code_array.itemsize() != 2 &&
+         code_array.itemsize() != 4 && code_array.itemsize() != 8)) {
+      throw std::invalid_argument("categorical codes must be native signed integer vectors");
+    }
+    if (category_array.ndim() != 1 || category_array.dtype().kind() != 'O' ||
+        category_array.shape(0) > 32) {
+      throw std::invalid_argument("categorical dictionaries require at most 32 exact strings");
+    }
+    if (feature == 0U) {
+      row_count = static_cast<std::size_t>(code_array.shape(0));
+    } else if (static_cast<std::size_t>(code_array.shape(0)) != row_count) {
+      throw std::invalid_argument("categorical code columns must have the same row count");
+    }
+    const auto code_info = code_array.request();
+    auto category_info = category_array.request();
+    const auto* category_data = static_cast<const char*>(category_info.ptr);
+    for (py::ssize_t index = 0; index < category_array.shape(0); ++index) {
+      PyObject* value;
+      std::memcpy(&value, category_data + index * category_info.strides[0], sizeof(value));
+      if (!PyUnicode_CheckExact(value)) {
+        throw std::invalid_argument("categorical dictionaries require at most 32 exact strings");
+      }
+    }
+    CodeColumn column{std::move(category_array), std::move(category_info), {}, {}};
+    column.row_indices.resize(row_count);
+    std::vector<int> slots(static_cast<std::size_t>(column.category_array.shape(0)) + 1U, -1);
+    const auto* code_data = static_cast<const char*>(code_info.ptr);
+    for (std::size_t row = 0; row < row_count; ++row) {
+      const char* ptr = code_data + static_cast<py::ssize_t>(row) * code_info.strides[0];
+      std::int64_t code;
+      switch (code_info.itemsize) {
+        case 1: { std::int8_t value; std::memcpy(&value, ptr, sizeof(value)); code = value; break; }
+        case 2: { std::int16_t value; std::memcpy(&value, ptr, sizeof(value)); code = value; break; }
+        case 4: { std::int32_t value; std::memcpy(&value, ptr, sizeof(value)); code = value; break; }
+        default: std::memcpy(&code, ptr, sizeof(code)); break;
+      }
+      if (code < -1 || code >= column.category_array.shape(0)) {
+        throw std::invalid_argument("categorical code is outside its dictionary");
+      }
+      int& slot = slots[static_cast<std::size_t>(code + 1)];
+      if (slot < 0) {
+        slot = static_cast<int>(column.used_codes.size());
+        column.used_codes.push_back(code);
+      }
+      column.row_indices[row] = static_cast<std::uint8_t>(slot);
+    }
+    dictionary_rows = std::max(dictionary_rows, column.used_codes.size());
+    columns.push_back(std::move(column));
+  }
+
+  // Reuse the established codec and CTR arithmetic on only the used dictionary
+  // entries. Encounter order preserves which invalid string raises first, and
+  // padding repeats an existing value instead of introducing a new missing key.
+  py::array table = detail::NumpyModule().attr("empty")(
+      py::make_tuple(dictionary_rows, width), py::arg("dtype") = py::dtype("O"),
+      py::arg("order") = "F").cast<py::array>();
+  auto** table_data = static_cast<PyObject**>(table.mutable_data());
+  const py::float_ missing(std::numeric_limits<double>::quiet_NaN());
+  for (std::size_t feature = 0; feature < width; ++feature) {
+    const auto& column = columns[feature];
+    const auto* category_data = static_cast<const char*>(column.category_info.ptr);
+    for (std::size_t row = 0; row < dictionary_rows; ++row) {
+      const auto code = column.used_codes[row < column.used_codes.size() ? row : 0U];
+      PyObject* value = missing.ptr();
+      if (code >= 0) {
+        std::memcpy(&value, category_data + code * column.category_info.strides[0], sizeof(value));
+      }
+      PyObject*& destination = table_data[feature * dictionary_rows + row];
+      Py_INCREF(value);
+      Py_XDECREF(destination);
+      destination = value;
+    }
+  }
+  py::tuple encoded_result = TransformInternal(std::move(table), std::move(feature_names), false);
+  const py::array_t<float> encoded = py::cast<py::array_t<float>>(encoded_result[0]);
+  const std::size_t output_width = output_sources.size();
+  if (row_count != 0U && output_width > std::numeric_limits<std::size_t>::max() / row_count) {
+    throw std::invalid_argument("feature-pipeline output dimensions are too large");
+  }
+  const std::size_t value_count = row_count * output_width;
+  float* data = new float[std::max<std::size_t>(value_count, 1U)];
+  py::capsule owner(data, [](void* ptr) { delete[] static_cast<float*>(ptr); });
+  py::array_t<float> transformed(
+      {static_cast<py::ssize_t>(row_count), static_cast<py::ssize_t>(output_width)},
+      {static_cast<py::ssize_t>(sizeof(float)), static_cast<py::ssize_t>(row_count * sizeof(float))},
+      data, owner);
+  const float* dictionary = encoded.data();
+  for (std::size_t column = 0; column < output_width; ++column) {
+    const auto& indices = columns[output_sources[column]].row_indices;
+    for (std::size_t row = 0; row < row_count; ++row) {
+      data[column * row_count + row] = dictionary[column * dictionary_rows + indices[row]];
+    }
+  }
+  return py::make_tuple(std::move(transformed), encoded_result[1], encoded_result[2]);
 }
 
