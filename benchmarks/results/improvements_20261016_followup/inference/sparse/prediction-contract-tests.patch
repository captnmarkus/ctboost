+def test_prefix_cache_does_not_index_a_later_out_of_schema_feature():
+    state = _routing_state()
+    state["trees"][1]["nodes"][0]["split_feature_id"] = 100_000
+    native = ctboost._core.GradientBooster.from_state(state)
+    pool = ctboost.Pool(np.asarray([[-3, 0, 0], [3, 128, 0]], dtype=np.float32))._handle
+    # Native state loading permits this later malformed tree. A valid prefix
+    # must not access its out-of-schema feature while building the shared cache.
+    for _ in range(2):
+        np.testing.assert_array_equal(native.predict(pool, 1), native._predict_uncached(pool, 1))
+        np.testing.assert_array_equal(np.asarray(native.predict_leaf_indices(pool, 1)).ravel(), [1, 2])
 
 
