+template <typename BinType, bool HasCategoricalSplits>
+void PredictCachedRows(const PredictionTree& tree,
+                       const BinType* bins,
+                       std::size_t num_rows,
+                       std::size_t dimension,
+                       std::size_t class_index,
+                       bool vector_updates,
+                       std::vector<float>& predictions) {
+  // Both decisions are constant across a tree's rows. Keep them outside the
+  // traversal loop so numeric scalar trees need only comparisons and one add.
+  if (vector_updates) {
+    for (std::size_t row = 0; row < num_rows; ++row) {
+      const int leaf_index = CachedLeafIndex<BinType, HasCategoricalSplits>(tree, bins, num_rows, row);
+      const PredictionNode& leaf = tree.nodes[static_cast<std::size_t>(leaf_index)];
+      for (std::size_t output = 0; output < dimension; ++output) {
+        predictions[row * dimension + output] += tree.vector_updates[leaf.payload_index + output];
+      }
+    }
+  } else {
+    for (std::size_t row = 0; row < num_rows; ++row) {
+      const int leaf_index = CachedLeafIndex<BinType, HasCategoricalSplits>(tree, bins, num_rows, row);
+      predictions[row * dimension + class_index] += tree.nodes[static_cast<std::size_t>(leaf_index)].leaf_update;
+    }
+  }
+}
